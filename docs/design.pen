                      "children": [
                        {
                          "type": "text",
                          "id": "TtTTq",
                          "fill": "$foreground",
                          "content": "Funcionamento",
                          "fontFamily": "Lexend",
                          "fontSize": 39,
                          "fontWeight": "600",
                          "letterSpacing": -0.5
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "id": "lzbkm",
