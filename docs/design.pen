                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Todo sistema de informação opera em um ciclo de três etapas, acompanhado por controle e retroalimentação:",
                      "lineHeight": 1.6,
                      "fontFamily": "Lexend",
                      "fontSize": 24,
                      "fontWeight": "normal",
                      "letterSpacing": 2.88
                    },
