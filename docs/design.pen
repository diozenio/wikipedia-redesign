                        },
                        {
                          "type": "frame",
                          "id": "R5z3Hb",
                          "name": "Acompanhar página",
                          "gap": 6,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "icon",
                              "id": "Ay43g",
                              "width": 14,
                              "height": 14,
                              "icon": "eye",
                              "library": "lucide",
